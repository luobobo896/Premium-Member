# Premium-Member production environment.
# Copy to deploy/.env, replace every CHANGE_ME, never commit .env.

# ---- PostgreSQL ----
DB_NAME=premium_member
DB_USER=premium_member
# MUST generate: openssl rand -hex 24
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_POOL_MAX=20
DB_POOL_MIN=5

# ---- Redis ----
# MUST generate: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
ADMIN_REDIS_DATABASE=1
C_REDIS_DATABASE=2

# ---- Admin JWT ----
# MUST generate separately: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ADMIN_ACCESS_SECRET
# MUST generate separately: openssl rand -base64 48
JWT_REFRESH_SECRET=CHANGE_ME_ADMIN_REFRESH_SECRET

# ---- C-end JWT (must differ from admin secrets) ----
# MUST generate separately: openssl rand -base64 48
C_JWT_ACCESS_SECRET=CHANGE_ME_C_ACCESS_SECRET
# MUST generate separately: openssl rand -base64 48
C_JWT_REFRESH_SECRET=CHANGE_ME_C_REFRESH_SECRET

# ---- Shared benefit card encryption ----
# MUST generate: openssl rand -base64 48
BENEFIT_CARD_SECRET=CHANGE_ME_CARD_SECRET

# ---- Public entry / CORS ----
# Comma-separated browser origins. Same-origin gateway means one entry is enough.
ADMIN_CORS_ALLOWED_ORIGINS=https://member.example.com
C_CORS_ALLOWED_ORIGINS=https://member.example.com
# Used only when up.sh generates a self-signed certificate; replace certs/ with real files.
PUBLIC_HOST=member.example.com
# Cookie path visible from the browser; matches nginx /c-api prefix.
C_COOKIE_PATH=/c-api/c/auth

# ---- Ports / runtime ----
HTTP_PORT=80
HTTPS_PORT=443
CACHE_PREFIX=pm:prod
SPRINGDOC_ENABLED=false
# Optional structured JSON logs: ecs, logstash or gelf; leave empty for plain text.
LOG_JSON_FORMAT=
# Optional JVM overrides. Defaults already include MaxRAMPercentage=75 and G1.
ADMIN_JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom
C_JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom

# ---- AI / payment placeholders ----
AI_PROVIDER=mock
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_SERIAL_NO=
