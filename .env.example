# Copy to .env and replace every value before use. Never commit .env.
DB_NAME=premium_member
DB_USER=premium_member
DB_PASSWORD=premium_member_dev_only
DB_HOST=127.0.0.1
DB_PORT=15432

REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=premium_member_dev_only

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-byte-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-secret

ADMIN_SERVER_PORT=5320
C_SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5666,http://127.0.0.1:5666
COOKIE_SECURE=false

# 微信 H5 支付预留；当前 WechatPayProvider 抛 UNSUPPORTED，不会发起支付。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_SERIAL_NO=

# AI 创作：mock 为本地占位；dashscope 未配置 key 时自动回退 mock。
AI_PROVIDER=mock
AI_STORAGE_DIR=./data/ai
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
DASHSCOPE_EDIT_MODEL=wanx2.1-imageedit
DASHSCOPE_VIDEO_MODEL=wan2.5-i2v-preview
# 图生视频/换装必须配置供应商可访问的公网地址（生产填 nginx 域名，本地可填局域网 IP）。
PUBLIC_ASSET_BASE_URL=
# 阿里云 OSS。四项配置齐全时优先 OSS；否则本地 AI_STORAGE_DIR。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=premium-member/ai/dev
